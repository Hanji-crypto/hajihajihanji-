# 招待制ベータの招待コード（形の見本。本物のコードはここに書かない）
# ローカル: このファイルを .streamlit/secrets.toml にコピーして値を入れる（secrets.toml は git に入れない）
# Streamlit Cloud: アプリの Settings → Secrets に同じ形で貼る
# この行ごと消す（キーが無い）と、ゲートと同意画面は出ずに誰でも見られる
invite_codes = ["ここに招待コード1", "ここに招待コード2"]

# データモード（data_mode.py）。"edgar_only" = SEC EDGAR の開示だけ（株価・オプション・Yahoo のデータは出さない）、"full" = 株価も出す
# 書かない時の既定: 上の invite_codes がある（招待制ベータ）なら "edgar_only"、無ければ "full"
data_mode = "edgar_only"

# SEC へのアクセスに付ける User-Agent（名前と連絡先メール。SEC の利用ルール）。書かなければ既定の識別子を使う
# sec_user_agent = "Whale-Eye 連絡先@example.com"
